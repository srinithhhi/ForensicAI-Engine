[Unit]
Description=Network connectivity watchdog (ping gateway, run netplan apply on failure)
Documentation=https://github.com/ForensicAI-Engine/host_setup/ubuntu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/network-watchdog.sh
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
